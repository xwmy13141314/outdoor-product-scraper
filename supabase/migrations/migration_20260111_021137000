-- 添加飞书同步状态字段
alter table product_scrapes 
add column if not exists feishu_synced boolean default false,
add column if not exists feishu_sync_status text,
add column if not exists feishu_record_id text,
add column if not exists feishu_sync_action text check (feishu_sync_action in ('created', 'updated', 'skipped'));

alter table products
add column if not exists feishu_synced boolean default false,
add column if not exists feishu_record_id text;

-- 创建索引
create index if not exists idx_product_scrapes_feishu_synced on product_scrapes(feishu_synced);
create index if not exists idx_products_feishu_synced on products(feishu_synced);